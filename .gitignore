# --- build artifacts ---
/target
fuzz/target
**/*.rs.bk

# --- frozen oracle clone + venv (re-clone per reference/FREEZE.md) ---
/reference/asc/
/reference/venv/

# --- python scratch ---
__pycache__/
*.pyc
.venv/

# --- logs (any level) ---
*.log

# --- generated benchmark outputs (reproduce with benches/bench_ascrs.py) ---
benches/ascrs_results.json
benches/raw_runs.json
benches/raw_runs.txt
bench-out.txt

# --- generated differential report (rewritten by tests/differential/run_differential.py) ---
tests/differential/report.md

# --- one-off evaluation outputs (verdicts live in BACKENDS.md) ---
crates/asc-decompile/eval/

# --- corpus fixtures: large APK/DEX binaries, reproduced via corpus/MANIFEST.md (now untracked) ---
corpus/

# --- fuzzer runtime state (seeds/ and regress/ ARE tracked) ---
crashes/
fuzz/crashes/

# --- debugging / session scratch ---
gui-check*.png
rebuilt-*.dex
*.heap
probe*.rs
.tmp_*.py

# --- IDA Pro database artifacts (writing these next to a fixture must
#     never make the tree dirty; fuzz/regress/ is tracked) ---
*.id0
*.id1
*.id2
*.nam
*.til
*.i64
