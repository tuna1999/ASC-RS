{
  "_comment": "ASC-RS API-35 <uri-relative-filter-group> oracle fixtures. source_expected is derived from the pinned AOSP android-15.0.0_r1 source. The 'oracle' field is filled by the Robolectric UriOracle harness (reference/oracle/uri_match) on a real Android API 35 framework; until then it is null. filter.data maps to asc_manifest::DataSpec; filter.groups[].allow + .data[].parts[{part,kind,value}] map to UriRelativeFilterGroup / UriPartMatcher. kinds: exact|prefix|suffix|pattern|advanced. parts: path|query|fragment.",
  "cases": [
    {"case_id": "T1_order", "rule": "R1+R6 order", "uri": "https://example.com/2", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/1"}]}]},
                  {"allow": true, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/2"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "T2_sibling_or_overrides", "rule": "R5 sibling OR", "uri": "https://example.com/direct", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path": "/direct"}],
       "groups": [{"allow": false, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/blocked"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "T3_and_within_group", "rule": "R3 AND", "uri": "https://example.com/a/b?token=1", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [
         {"part": "path", "kind": "exact", "value": "/a/b"},
         {"part": "query", "kind": "exact", "value": "token=1"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "T4_and_within_group_miss", "rule": "R3 AND fails", "uri": "https://example.com/a/b?other=2", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [
         {"part": "path", "kind": "exact", "value": "/a/b"},
         {"part": "query", "kind": "exact", "value": "token=1"}]}]}]},
     "source_expected": "cannot_match", "oracle": null},
    {"case_id": "T5_empty_group", "rule": "R3 zero filters", "uri": "https://example.com/x", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": []}]},
     "source_expected": "cannot_match", "oracle": null},
    {"case_id": "T6_block_before_allow", "rule": "R6 order", "uri": "https://example.com/x", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": false, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/x"}]}]},
                  {"allow": true, "data": [{"parts": [{"part": "path", "kind": "prefix", "value": "/x"}]}]}]},
     "source_expected": "cannot_match", "oracle": null},
    {"case_id": "T7_allow_before_block", "rule": "R6 order reversal", "uri": "https://example.com/x", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "path", "kind": "prefix", "value": "/x"}]}]},
                  {"allow": false, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/x"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "T8_no_host_inert", "rule": "R4 host dependency", "uri": "https://example.com/a/b?token=1", "flag_on": true,
     "filter": {"data": [{"scheme": "https"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/a/b"}]}]}]},
     "source_expected": "unknown", "oracle": null},
    {"case_id": "T10_block_group_hit", "rule": "R5 block", "uri": "https://example.com/private", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path": "/public"}],
       "groups": [{"allow": false, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/private"}]}]}]},
     "source_expected": "cannot_match", "oracle": null},
    {"case_id": "T11_path_whole_part", "rule": "R7 whole part", "uri": "https://example.com/a/", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/a"}]}]}]},
     "source_expected": "cannot_match", "oracle": null},
    {"case_id": "T12_fragment", "rule": "R7 FRAGMENT", "uri": "https://example.com/a#sec", "flag_on": true,
