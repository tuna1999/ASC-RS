    {"case_id": "T13_fragment_absent", "rule": "R7 FRAGMENT absent", "uri": "https://example.com/a", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "fragment", "kind": "exact", "value": "sec"}]}]}]},
     "source_expected": "cannot_match", "oracle": null},
    {"case_id": "T14_query_amp", "rule": "R8 query &", "uri": "https://example.com/a?token=1&x=2", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "query", "kind": "exact", "value": "token=1"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "T15_query_semi", "rule": "R8 query ;", "uri": "https://example.com/a?x=2;token=1", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "query", "kind": "exact", "value": "token=1"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "T16_pattern_unknown", "rule": "R9 simple glob (oracle-open)", "uri": "https://example.com/a/123", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "path", "kind": "pattern", "value": "/a/.*"}]}]}]},
     "source_expected": "unknown", "oracle": null},
    {"case_id": "T18_advanced_unknown", "rule": "R9 advanced glob (oracle-open)", "uri": "https://example.com/a/42", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "path", "kind": "advanced", "value": "/a/[0-9]+"}]}]}]},
     "source_expected": "unknown", "oracle": null},
    {"case_id": "T19_flag_off_group_only", "rule": "R10 flag off (authMatch)", "uri": "https://example.com/a/b", "flag_on": false,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/a/b"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "T20_flag_off_sibling", "rule": "R10 flag off sibling", "uri": "https://example.com/public", "flag_on": false,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path": "/public"}],
       "groups": [{"allow": false, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/private"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "T23_pooled_path", "rule": "R2 pooled", "uri": "https://example.com/b", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com", "path": "/a"},
                         {"scheme": "https", "host": "example.com", "path": "/b"}],
       "groups": []},
     "source_expected": "matches", "oracle": null},
    {"case_id": "T24_doc_and_vs_or", "rule": "R3+R5 doc example", "uri": "https://project.example.com/path?token=secret", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "project.example.com"}, {"path": "/path"}],
       "groups": [{"allow": false, "data": [{"parts": [
         {"part": "path", "kind": "exact", "value": "/excluded"},
         {"part": "query", "kind": "exact", "value": "token=secret"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "F1_authmatch_no_path", "rule": "authMatch (F1)", "uri": "https://example.com/x", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}], "groups": []},
     "source_expected": "matches", "oracle": null},
    {"case_id": "C1_empty_path_exact", "rule": "empty path Exact \"\" (F1)", "uri": "https://example.com", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path": ""}], "groups": []},
     "source_expected": "matches", "oracle": null},
    {"case_id": "C1_empty_path_vs_root", "rule": "empty path != \"/\" (F1)", "uri": "https://example.com/", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path": ""}], "groups": []},
     "source_expected": "cannot_match", "oracle": null},
    {"case_id": "C1_empty_path_after_query", "rule": "empty path with query (F1)", "uri": "https://example.com?token=1", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path": ""}], "groups": []},
     "source_expected": "matches", "oracle": null},
    {"case_id": "C1_empty_path_prefix", "rule": "pathPrefix \"\" (F1)", "uri": "https://example.com/x", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path_prefix": ""}], "groups": []},
     "source_expected": "matches", "oracle": null},
    {"case_id": "C1_empty_path_group", "rule": "group path \"\" (F1)", "uri": "https://example.com", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "path", "kind": "exact", "value": ""}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "C2_backslash_host", "rule": "backslash authority terminator (F2)", "uri": "https://example.com\\private", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}], "groups": []},
     "source_expected": "matches", "oracle": null},
    {"case_id": "C2_backslash_path", "rule": "backslash kept in path (F2)", "uri": "https://example.com\\private", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path": "\\private"}], "groups": []},
     "source_expected": "matches", "oracle": null},
    {"case_id": "C2_backslash_path_query", "rule": "backslash path + query (F2)", "uri": "https://example.com\\private?token=1", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path": "\\private"}], "groups": []},
     "source_expected": "matches", "oracle": null},
    {"case_id": "F3_unknown_block_then_allow", "rule": "F3 ordered unknown-block -> allow", "uri": "https://example.com/x", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": false, "data": [{"parts": [{"part": "path", "kind": "pattern", "value": "/x"}]}]},
                  {"allow": true, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/x"}]}]}]},
     "source_expected": "unknown", "oracle": null},
    {"case_id": "F3_sibling_unknown_plus_block", "rule": "F3 sibling unknown OR block", "uri": "https://example.com/blocked", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}, {"path_pattern": "/a.*"}],
       "groups": [{"allow": false, "data": [{"parts": [{"part": "path", "kind": "exact", "value": "/blocked"}]}]}]},
     "source_expected": "unknown", "oracle": null},
    {"case_id": "F4_query_prefix", "rule": "F4 query kind prefix", "uri": "https://example.com/a?token=123", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "query", "kind": "prefix", "value": "token="}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "F4_query_suffix", "rule": "F4 query kind suffix", "uri": "https://example.com/a?state=done", "flag_on": true,
     "filter": {"data": [{"scheme": "https", "host": "example.com"}],
       "groups": [{"allow": true, "data": [{"parts": [{"part": "query", "kind": "suffix", "value": "=done"}]}]}]},
     "source_expected": "matches", "oracle": null},
    {"case_id": "F5_port_match", "rule": "F5 numeric port", "uri": "https://example.com:8080/x", "flag_on": true,
